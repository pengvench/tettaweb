RewriteEngine On
Options -Indexes

RedirectMatch 403 ^/snake-data(?:/|$)

RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ https://tetta-prod.ru/$1 [R=301,L,NE]

RewriteRule ^(privacy|filming|contacts)$ https://tetta-prod.ru/$1/ [R=301,L,NE]

RewriteRule ^videosemka/?$ https://tetta-prod.ru/filming/ [R=301,L,NE]

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.tetta-prod\.ru$ [NC]
RewriteRule ^ https://tetta-prod.ru%{REQUEST_URI} [R=301,L,NE]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  <FilesMatch "\.(html|json|css|js|mjs)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
    Header unset ETag
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

FileETag None
