# ============================================
# TETTA (tetta-prod.ru) — БАТЧ-22: канонизация хоста
# 301: www.tetta-prod.ru -> tetta-prod.ru и http -> https
#
# Причина: Google Search Console присылал «Вариант страницы
# с тегом canonical» на http://tetta-prod.ru/ — все 4 варианта
# хоста (http/https, www/без www) отдавали 200 БЕЗ редиректа.
# После деплоя проверить:
#   curl -sI "http://tetta-prod.ru/" | head -1      -> 301
#   curl -sI "https://www.tetta-prod.ru/" | head -1 -> 301
#   curl -sIL "http://www.tetta-prod.ru/" | rg HTTP -> один 301 на https non-www
#
# ЕСЛИ браузер зациклится (ERR_TOO_MANY_REDIRECTS):
# удалите блок <IfModule mod_rewrite.c> ниже и включите
# тумблер «Перенаправлять на HTTPS» в панели Beget
# (Сайты -> tetta-prod.ru -> Перенаправлять на HTTPS).
# ============================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 301: www -> без www (на https независимо от протокола запроса)
    RewriteCond %{HTTP_HOST} ^www\.tetta-prod\.ru\.?$ [NC]
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule ^(.*)$ https://tetta-prod.ru/$1 [R=301,L]

    # 301: http -> https (срабатывает только если ОБА признака
    # говорят «не https» — страховка от петли на прокси-хостинге)
    RewriteCond %{HTTP:HTTPS} !on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule ^(.*)$ https://tetta-prod.ru/$1 [R=301,L]
</IfModule>

# ============================================
# TETTA (tetta-prod.ru) — БАТЧ-13: кеширование статики
# Все статические ассеты версионированы через ?v= в HTML/JS,
# поэтому их можно кешировать агрессивно (1 год, immutable).
# HTML — без кеша, чтобы деплой применялся мгновенно.
#
# ВАЖНО (Beget): если nginx отдаёт статику мимо Apache, этот
# файл на заголовки не повлияет — проверка после загрузки:
# curl -sI "https://tetta-prod.ru/css/pages/filming-page.min.css?v=20260924-9" | grep -i cache-control
# Ожидаем: public, max-age=31536000, immutable.
# Если осталось max-age=604800 — кеш управляется nginx'ом хостинга,
# нужно просить поддержку Beget (запрос в README батча).
# ============================================

<IfModule mod_expires.c>
    ExpiresActive On

    # Версионированная статика — год
    ExpiresByType text/css                "access plus 1 year"
    ExpiresByType application/javascript  "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType text/javascript         "access plus 1 year"
    ExpiresByType image/webp              "access plus 1 year"
    ExpiresByType image/jpeg              "access plus 1 year"
    ExpiresByType image/png               "access plus 1 year"
    ExpiresByType image/gif               "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 year"
    ExpiresByType image/x-icon            "access plus 1 year"
    ExpiresByType font/woff2              "access plus 1 year"
    ExpiresByType font/woff               "access plus 1 year"
    ExpiresByType video/webm              "access plus 1 year"

    # HTML и JSON — короткий срок (обновляются без смены имени)
    ExpiresByType text/html               "access plus 10 minutes"
    ExpiresByType application/json        "access plus 1 hour"

    ExpiresDefault                        "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|webp|jpe?g|png|gif|svg|ico|woff2?|webm|mp4)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html?$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Сжатие (если mod_deflate доступен и ещё не включён хостингом)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
