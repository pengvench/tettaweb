RewriteEngine On
Options -Indexes

RedirectMatch 403 ^/snake-data(?:/|$)

RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ https://tetta-prod.ru/$1 [R=301,L,NE]

RewriteRule ^(privacy|filming|contacts)$ https://tetta-prod.ru/$1/ [R=301,L,NE]

RewriteRule ^videosemka/?$ https://tetta-prod.ru/filming/ [R=301,L,NE]

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.tetta-prod\.ru$ [NC]
RewriteRule ^ https://tetta-prod.ru%{REQUEST_URI} [R=301,L,NE]

ErrorDocument 404 /404.html

# Сжатие текстовых форматов и шрифтов (TTF без сжатия весит 500КБ, с gzip ~вдвое меньше)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/xml image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf application/x-font-ttf application/font-sfnt
</IfModule>

<IfModule mod_headers.c>
  # HTML и JSON всегда свежие: точка входа, через которую обновляются версии ассетов
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
    Header unset ETag
  </FilesMatch>
  # CSS/JS версионируются query-параметром ?v= в HTML, поэтому кешируются надолго
  <FilesMatch "\.(css|js|mjs)$">
    Header set Cache-Control "public, max-age=2592000"
    Header unset Pragma
    Header unset Expires
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|gif|webp|avif|svg|ico|webm|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(ttf|otf|woff2?|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

FileETag None
